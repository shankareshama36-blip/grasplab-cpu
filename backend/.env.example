# Database Configuration (Postgres for production, fallback to SQLite locally)
DATABASE_URL=sqlite:///./grasplab.db

# Authentication Secret for HS256 JWT
JWT_SECRET=grasplab-super-secret-key-change-in-production-min-32-chars

# CORS Allowed Origins (Comma-separated, no wildcards in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://grasplab-web.onrender.com
